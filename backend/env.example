# Desarrollo local. Copia este archivo como .env y cambia los secretos.
SECRET_KEY=cambia-esta-clave-local
JWT_SECRET_KEY=cambia-esta-clave-jwt-local
JWT_EXP_MINUTES=480

# Déjalo vacío para usar SQLite local. En Azure usaremos mysql+pymysql://...
DATABASE_URL=

# Orígenes permitidos para el frontend.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
